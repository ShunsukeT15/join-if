{
  "name": "himitsu-shukketsu",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @himitsu/api",
    "dev:web": "npm run dev -w @himitsu/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke": "node infra/scripts/smoke-test.mjs",
    "doctor": "infra/scripts/doctor.sh",
    "release": "infra/scripts/release.sh",
    "setup:aws": "infra/scripts/setup-aws.sh",
    "ops": "infra/scripts/ops.sh"
  },
  "engines": {
    "node": ">=22"
  }
}
