# Port the API listens on
PORT=8787
# memory | postgres
DATA_STORE=memory
# Required when DATA_STORE=postgres (Supabase: use the direct / pooler connection string)
DATABASE_URL=
# 32 random bytes, base64. Generate: npm run gen-key -w @himitsu/api
TOKEN_ENC_KEY=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# true when running behind a proxy that sets X-Forwarded-For
TRUST_PROXY=false
# off to disable rate limiting (local development only)
RATE_LIMIT=on
