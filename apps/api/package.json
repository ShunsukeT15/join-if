{
  "name": "@himitsu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/infrastructure/persistence/postgres/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen-key": "tsx src/genKey.ts",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@himitsu/contracts": "^0.1.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
